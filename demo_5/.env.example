# ============================================================
# Demo 5 环境变量模板
# 用法：复制本文件为 .env，再填入真实的 API Key
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会被提交；本模板中不要写真实密钥
# ============================================================

# 阿里百炼 API Key（必填）
DASHSCOPE_API_KEY=sk-your-key-here

# 阿里百炼 OpenAI 兼容接口地址（必填）
LLM_BASE_URL=https://llm-6uu8pzntku1dyylb.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 主 Agent 使用的模型（可选，默认 qwen3.7-plus）
# 可选：qwen3.7-plus（推荐）/ qwen3.6-plus / qwen-plus（快但易编造）/ qwen3.7-flash / qwen-max / deepseek-v4-pro / glm-5.3 / kimi-k3 ...
LLM_MODEL=qwen3.7-plus

# 子代理使用的模型（可选，留空则与主 Agent 相同；可以换成更便宜更快的模型）
SUBAGENT_MODEL=

# 采样温度（可选）
LLM_TEMPERATURE=0.3

# MCP 配置文件（可选，默认 mcp_servers.json）
MCP_CONFIG=mcp_servers.json
