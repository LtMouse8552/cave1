# ============================================================
# Demo 5 环境变量模板
# 用法：复制本文件为 .env，然后选择下面【方案一】或【方案二】，
#       把启用的一组保持未注释，另一组注释掉（行首加 #）
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会被提交；本模板中不要写真实密钥
# ============================================================

# ---------- 方案一：云端模型（阿里百炼，推荐，效果最好） ----------
# 阿里百炼 API Key（必填，到百炼控制台获取）
# DASHSCOPE_API_KEY=sk-your-key-here
# 阿里百炼 OpenAI 兼容接口地址
# LLM_BASE_URL=https://llm-6uu8pzntku1dyylb.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 主 Agent 使用的模型（可选：qwen3.7-plus / deepseek-v4-pro / glm-5.3 / kimi-k3 等）
# LLM_MODEL=qwen3.7-plus
# 云端建议关闭小模型模式，启用完整 Deep Agent（子代理、长报告）
# LITE_MODE=false

# ---------- 方案二：本地模型（Ollama 等 OpenAI 兼容服务，零 API 费用） ----------
# 先安装 Ollama 并拉取模型：ollama pull qwen3.5:0.8B
# DASHSCOPE_API_KEY=ollama-local
# 本地无需真 key，仅作非空占位
# LLM_BASE_URL=http://localhost:11434/v1
# 模型名以 ollama list 输出为准
# LLM_MODEL=qwen3.5:0.8B
# 小模型模式：true 时关闭子代理、使用精简提示词
# LITE_MODE=true
# 本地首 token 慢，加大超时避免 120s 截断
# LLM_TIMEOUT=300

# ---------- 通用配置 ----------
# 子代理使用的模型（可选，留空则与主 Agent 相同；LITE_MODE 下子代理被禁用）
SUBAGENT_MODEL=
# 采样温度
LLM_TEMPERATURE=0.3
# MCP 配置文件
MCP_CONFIG=mcp_servers.json
